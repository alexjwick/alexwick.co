{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/project-24cast", "destination": "/", "permanent": true },
    { "source": "/project-24cast.html", "destination": "/", "permanent": true },
    { "source": "/project-deepfake", "destination": "/", "permanent": true },
    { "source": "/project-deepfake.html", "destination": "/", "permanent": true },
    { "source": "/project-weenix", "destination": "/", "permanent": true },
    { "source": "/project-weenix.html", "destination": "/", "permanent": true },
    { "source": "/resume", "destination": "/", "permanent": false },
    { "source": "/resume.html", "destination": "/", "permanent": false },
    { "source": "/Alex_Wick_Resume.pdf", "destination": "/", "permanent": false },
    { "source": "/Alex_Wick_Resume.docx", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: https:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    }
  ]
}
