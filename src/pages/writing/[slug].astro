---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getPosts, isoDate } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} | Alex Wick`} description={post.data.description} type="article">
  <main class="page">
    <a class="masthead" href="/">Alex Wick</a>
    <article>
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Base>
